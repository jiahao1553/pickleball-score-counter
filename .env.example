# Firebase web app config for TOURNAMENT MODE (local mode never uses it).
# Copy this file to .env and paste the values from:
#   Firebase console -> Project settings -> Your apps -> Web app -> SDK setup
# Then enable in the console:
#   Authentication -> Sign-in method -> Anonymous
#   Firestore Database (production mode; rules are deployed by deploy.sh)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
